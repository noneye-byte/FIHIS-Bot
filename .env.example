# --- Required ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# Same page -> General Information -> Application ID
DISCORD_CLIENT_ID=

# --- Strongly recommended ----------------------------------------------------
# Your server's ID (enable Developer Mode, right-click the server -> Copy Server ID).
# With this set, /fihas appears instantly instead of taking up to an hour.
DISCORD_GUILD_ID=

# --- Setup web UI ------------------------------------------------------------
# Password for the setup UI at http://<server-ip>:8080/
# Leave blank and one is generated on first start and printed in the container log.
WEB_PASSWORD=

# --- Text commands -----------------------------------------------------------
# Fallback for servers where slash commands never appear. Requires the
# MESSAGE CONTENT INTENT under Bot -> Privileged Gateway Intents in the portal.
# Without it the bot still starts, but only /fihas and the web UI work.
COMMAND_PREFIX=!fihas
PREFIX_ENABLED=true

# --- Voice playback ----------------------------------------------------------
# "/fihas play" plays the clip shipped in the image to whoever is in a voice
# channel. This is the default volume, 0-200, as a percentage of the clip as
# recorded — 100 is loud. Editable in the web UI under "Voice playback"; leave
# blank unless you want this file to own the setting.
VOICE_VOLUME=

# --- Built-in RSSHub ---------------------------------------------------------
# RSSHub ships inside the image and runs alongside the bot, so the default feed
# is one nobody else shares. Set false to save ~150MB of RAM and use public
# mirrors (or your own RSSHub) instead.
RSSHUB_ENABLED=true
RSSHUB_PORT=1200
# RSSHub's X route needs its own credentials: the auth_token cookie of a
# logged-in X session. See https://docs.rsshub.app/deploy/config#x-twitter
# Easier to paste into the web UI under "RSS & sources" — it restarts RSSHub
# with the new token, and a token saved there wins over this one.
TWITTER_AUTH_TOKEN=
# Every other RSSHub variable set here is passed through to it as well.

# --- Optional: seed the config -----------------------------------------------
# Each variable is applied when first seen, and again only when you change it
# here — never on a plain restart, so edits made in the web UI or in Discord are
# not undone the next time the container starts. A blank value means "not set".
X_HANDLE=F_I_H_A_S
DISCORD_CHANNEL_ID=
# Comma-separated role IDs to ping
PING_ROLE_ID=
POLL_INTERVAL_SECONDS=120
# Comma-separated RSS feeds, tried in order. Overrides the built-in defaults,
# including the bundled RSSHub, so include it yourself if you set this.
RSS_URLS=
# How feeds are fetched. All three live under "RSS & sources" in the web UI —
# set them here only to have the container own the value, because anything set
# here is re-applied on every restart. Defaults: 20s, 20 items, built-in agent.
RSS_TIMEOUT_SECONDS=
RSS_MAX_ITEMS=
# Some mirrors block unfamiliar clients.
RSS_USER_AGENT=

# --- Optional: official X API ------------------------------------------------
# Only useful on a paid (Basic+) X API plan. Free tier cannot read timelines.
# When set, the bot tries this first and falls back to RSS automatically.
X_BEARER_TOKEN=

TZ=Etc/UTC
